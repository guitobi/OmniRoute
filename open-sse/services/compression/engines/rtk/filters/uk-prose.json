{
  "id": "uk-prose",
  "label": "Ukrainian Prose / Filler Collapser",
  "description": "Collapse Ukrainian polite/filler phrases, repeated lines, and long multiword fillers in user messages.",
  "category": "generic",
  "priority": 20,
  "match": {
    "outputTypes": ["generic-output"],
    "commands": [],
    "patterns": ["\\b????\\s+?????\\b", "\\b?????\\b", "\\b?????\\b", "\\b??????[??]\\b"]
  },
  "rules": {
    "includePatterns": [],
    "dropPatterns": ["^\\s*$", "^(?:????\\s+?????|?????|?????).*$", "^.{0,40}??\\s+???????.*$"],
    "collapsePatterns": [
      "(????\\s+?????[\\.,]*){2,}",
      "(?????[\\.,]*){2,}",
      "(^|(\\\\n))+\\s*(?????????\\s+??????|Previous message)[^\\\\n]{0,200}"
    ],
    "deduplicate": true,
    "maxLines": 200,
    "headLines": 30,
    "tailLines": 30
  },
  "preserve": {
    "errorPatterns": ["???????", "error", "failed", "exception"],
    "summaryPatterns": []
  },
  "tests": [
    {
      "name": "uk polite collapse",
      "input": "??? ?????. ??? ?????. ??? ?????. ????!\\nSome useful content here.",
      "expected": "??? ?????. ????!\\nSome useful content here."
    }
  ]
}
